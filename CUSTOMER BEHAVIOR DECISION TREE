      "source": [
        "# ============================================\n",
        "# QUESTION 2: CUSTOMER BEHAVIOR DECISION TREE\n",
        "# ============================================\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.tree import DecisionTreeClassifier, plot_tree\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 1. Create customer behavioral dataset\n",
        "# ------------------------------------------------\n",
        "\n",
        "data = {\n",
        "    \"Age\": [\n",
        "        20, 22, 25, 28, 30,\n",
        "        32, 35, 38, 40, 42,\n",
        "        45, 48, 50, 52, 55\n",
        "    ],\n",
        "\n",
        "    \"Income\": [\n",
        "        20000, 25000, 30000, 35000, 40000,\n",
        "        45000, 50000, 55000, 60000, 65000,\n",
        "        70000, 75000, 85000, 90000, 100000\n",
        "    ],\n",
        "\n",
        "    \"Previous_Purchase\": [\n",
        "        \"No\", \"No\", \"No\", \"Yes\", \"Yes\",\n",
        "        \"No\", \"Yes\", \"Yes\", \"Yes\", \"Yes\",\n",
        "        \"Yes\", \"Yes\", \"Yes\", \"Yes\", \"Yes\"\n",
        "    ],\n",
        "\n",
        "    \"Buying_Range\": [\n",
        "        \"Low\", \"Low\", \"Low\", \"Low\", \"Medium\",\n",
        "        \"Medium\", \"Medium\", \"Medium\", \"Medium\", \"High\",\n",
        "        \"High\", \"High\", \"High\", \"High\", \"High\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"Customer Behavioral Dataset:\")\n",
        "print(df)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 2. Encode categorical columns\n",
        "# ------------------------------------------------\n",
        "\n",
        "purchase_encoder = LabelEncoder()\n",
        "target_encoder = LabelEncoder()\n",
        "\n",
        "df[\"Previous_Purchase\"] = purchase_encoder.fit_transform(\n",
        "    df[\"Previous_Purchase\"]\n",
        ")\n",
        "\n",
        "df[\"Buying_Range\"] = target_encoder.fit_transform(\n",
        "    df[\"Buying_Range\"]\n",
        ")\n",
        "\n",
        "print(\"\\nEncoded Dataset:\")\n",
        "print(df)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 3. Select features and target\n",
        "# ------------------------------------------------\n",
        "\n",
        "X = df[\n",
        "    [\"Age\", \"Income\", \"Previous_Purchase\"]\n",
        "]\n",
        "\n",
        "y = df[\"Buying_Range\"]\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 4. Train Decision Tree\n",
        "# ------------------------------------------------\n",
        "\n",
        "model = DecisionTreeClassifier(\n",
        "    criterion=\"entropy\",\n",
        "    max_depth=3,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"\\nDecision Tree Model trained successfully.\")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 5. Display Decision Tree\n",
        "# ------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(16, 9))\n",
        "\n",
        "plot_tree(\n",
        "    model,\n",
        "    feature_names=[\n",
        "        \"Age\",\n",
        "        \"Income\",\n",
        "        \"Previous_Purchase\"\n",
        "    ],\n",
        "    class_names=target_encoder.classes_,\n",
        "    filled=True,\n",
        "    rounded=True\n",
        ")\n",
        "\n",
        "plt.title(\"Decision Tree for Customer Buying Range\")\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 6. Test predictions for new customers\n",
        "# ------------------------------------------------\n",
        "\n",
        "new_customers = pd.DataFrame({\n",
        "    \"Age\": [24, 37, 51],\n",
        "    \"Income\": [28000, 52000, 85000],\n",
        "    \"Previous_Purchase\": [\n",
        "        purchase_encoder.transform([\"No\"])[0],\n",
        "        purchase_encoder.transform([\"Yes\"])[0],\n",
        "        purchase_encoder.transform([\"Yes\"])[0]\n",
        "    ]\n",
        "})\n",
        "\n",
        "predictions = model.predict(new_customers)\n",
        "\n",
        "predicted_labels = target_encoder.inverse_transform(predictions)\n",
        "\n",
        "print(\"\\nNew Customer Predictions:\")\n",
        "\n",
        "for i in range(len(new_customers)):\n",
        "    print(\n",
        "        f\"Customer {i+1}: \"\n",
        "        f\"Age={new_customers.iloc[i]['Age']}, \"\n",
        "        f\"Income={new_customers.iloc[i]['Income']}, \"\n",
        "        f\"Previous Purchase={new_customers.iloc[i]['Previous_Purchase']} \"\n",
        "        f\"-> Buying Range = {predicted_labels[i]}\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 7. Explanation\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\n==============================================\")\n",
        "print(\"EXPLANATION\")\n",
        "print(\"==============================================\")\n",
        "\n",
        "print(\"\"\"\n",
        "The Decision Tree predicts a customer's buying range using\n",
        "Age, Income and Previous Purchase history.\n",
        "\n",
        "The tree starts with the feature that provides the most useful\n",
        "split in the training data. It then follows different branches\n",
        "based on the customer's feature values.\n",
        "\n",
        "For example, customers with higher income and previous purchases\n",
        "are more likely to be classified into a higher buying range,\n",
        "while customers with lower income and no previous purchase are\n",
        "more likely to be classified into a lower buying range.\n",
        "\n",
        "The leaf node reached by a customer determines the final\n",
        "prediction: Low, Medium or High.\n",
        "\"\"\")"
      ],
