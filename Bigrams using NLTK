      "cell_type": "code",
      "source": [
        "# Install NLTK\n",
        "!pip install -q nltk\n",
        "\n",
        "import nltk\n",
        "from nltk.util import ngrams\n",
        "\n",
        "# Download tokenizer\n",
        "nltk.download('punkt_tab')\n",
        "\n",
        "# Given sentence\n",
        "sentence = \"Machine learning is transforming industries.\"\n",
        "\n",
        "# Tokenize the sentence\n",
        "words = nltk.word_tokenize(sentence)\n",
        "\n",
        "# Generate bigrams\n",
        "bigrams = list(ngrams(words, 2))\n",
        "\n",
        "print(\"Original Sentence:\")\n",
        "print(sentence)\n",
        "\n",
        "print(\"\\nTokens:\")\n",
        "print(words)\n",
        "\n",
        "print(\"\\nBigrams:\")\n",
        "for bigram in bigrams:\n",
        "    print(bigram)\n",
        "\n",
        "print(\"\\nExplanation:\")\n",
        "print(\"A bigram consists of two consecutive words/tokens.\")\n",
        "print(\"Bigrams are useful in language models because they capture\")\n",
        "print(\"the relationship and context between neighboring words.\")"
      ],
