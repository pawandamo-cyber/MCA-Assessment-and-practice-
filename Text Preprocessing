      "source": [
        "import string\n",
        "\n",
        "# Given text\n",
        "text = \"Hello! My name is Alice. I'm learning NLP, and it's awesome!\"\n",
        "\n",
        "# Step 1: Remove all punctuation\n",
        "cleaned_text = text.translate(str.maketrans(\"\", \"\", string.punctuation))\n",
        "\n",
        "# Step 2: Convert all text to lowercase\n",
        "cleaned_text = cleaned_text.lower()\n",
        "\n",
        "# Step 3: Display the cleaned text\n",
        "print(\"Original Text:\")\n",
        "print(text)\n",
        "\n",
        "print(\"\\nCleaned Text:\")\n",
        "print(cleaned_text)\n",
        "\n",
        "print(\"\\nExplanation:\")\n",
        "print(\"Punctuation marks are removed to reduce unnecessary characters.\")\n",
        "print(\"Converting text to lowercase makes words consistent regardless of capitalization.\")"
