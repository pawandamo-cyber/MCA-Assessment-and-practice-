      "source": [
        "import nltk\n",
        "from nltk.tokenize import word_tokenize\n",
        "from nltk.corpus import stopwords\n",
        "\n",
        "# Download required NLTK data\n",
        "nltk.download(\"punkt\")\n",
        "nltk.download(\"punkt_tab\")\n",
        "nltk.download(\"stopwords\")\n",
        "\n",
        "# Given sentence\n",
        "sentence = \"Natural Language Processing is a field of Artificial Intelligence.\"\n",
        "\n",
        "# Step 1: Tokenize the sentence\n",
        "tokens = word_tokenize(sentence)\n",
        "\n",
        "# Step 2: Get English stopwords\n",
        "stop_words = set(stopwords.words(\"english\"))\n",
        "\n",
        "# Step 3: Remove stopwords\n",
        "filtered_tokens = [\n",
        "    word for word in tokens\n",
        "    if word.lower() not in stop_words and word.isalpha()\n",
        "]\n",
        "\n",
        "# Display results\n",
        "print(\"Original Sentence:\")\n",
        "print(sentence)\n",
        "\n",
        "print(\"\\nAll Tokens:\")\n",
        "print(tokens)\n",
        "\n",
        "print(\"\\nTokens after Stopword Removal:\")\n",
        "print(filtered_tokens)\n",
        "\n",
        "print(\"\\nExplanation:\")\n",
        "print(\"Stopwords are common words such as 'is', 'a', and 'of' that often\")\n",
        "print(\"provide limited information for many NLP tasks.\")\n",
        "print(\"Removing them can reduce the number of words that need to be processed.\")"
