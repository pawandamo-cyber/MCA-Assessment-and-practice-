    {
      "cell_type": "code",
      "source": [
        "# Install NLTK\n",
        "!pip install -q nltk\n",
        "\n",
        "import nltk\n",
        "from nltk.util import ngrams\n",
        "\n",
        "# Download tokenizer\n",
        "nltk.download('punkt_tab')\n",
        "\n",
        "# Given sentence\n",
        "sentence = \"Deep learning is a subset of machine learning.\"\n",
        "\n",
        "# Tokenize the sentence\n",
        "words = nltk.word_tokenize(sentence)\n",
        "\n",
        "# Generate trigrams\n",
        "trigrams = list(ngrams(words, 3))\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"TRIGRAM GENERATION USING NLTK\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"\\nOriginal Sentence:\")\n",
        "print(sentence)\n",
        "\n",
        "print(\"\\nTokens:\")\n",
        "print(words)\n",
        "\n",
        "print(\"\\nTrigrams:\")\n",
        "for trigram in trigrams:\n",
        "    print(trigram)\n",
        "\n",
        "print(\"\\nExplanation:\")\n",
        "print(\"A trigram consists of three consecutive words or tokens.\")\n",
        "print(\"Trigrams help language models understand the context of\")\n",
        "print(\"three neighboring words and can be used to predict the\")\n",
        "print(\"next word in a sequence.\")"
      ],
