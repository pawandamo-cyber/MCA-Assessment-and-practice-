        "import spacy\n",
        "\n",
        "# Download and load the English SpaCy model\n",
        "!python -m spacy download en_core_web_sm\n",
        "\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "# Given sentence\n",
        "text = \"I am learning Natural Language Processing and it is fun!\"\n",
        "\n",
        "# Step 1: Convert to lowercase\n",
        "text_lower = text.lower()\n",
        "\n",
        "# Process the text\n",
        "doc = nlp(text_lower)\n",
        "\n",
        "# Step 2 & 3: Remove stopwords and lemmatize\n",
        "final_words = []\n",
        "\n",
        "for token in doc:\n",
        "    if not token.is_stop and not token.is_punct:\n",
        "        final_words.append(token.lemma_)\n",
        "\n",
        "# Display results\n",
        "print(\"=\" * 60)\n",
        "print(\"TEXT PREPROCESSING\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"\\nOriginal Sentence:\")\n",
        "print(text)\n",
        "\n",
        "print(\"\\nLowercase Sentence:\")\n",
        "print(text_lower)\n",
        "\n",
        "print(\"\\nFinal Preprocessed Sentence:\")\n",
        "print(\" \".join(final_words))\n",
        "\n",
        "print(\"\\nExplanation:\")\n",
        "print(\"1. Lowercasing makes the text consistent.\")\n",
        "print(\"2. Stopwords such as 'am', 'and', 'it', and 'is' are removed.\")\n",
        "print(\"3. Lemmatization converts words to their base forms.\")\n",
        "print(\"   Example: learning -> learn\")\n",
        "print(\"\\nThese steps reduce unnecessary variations in text and make\")\n",
        "print(\"the data easier for NLP algorithms to process.\")\n",
        "print(\"=\" * 60)"
