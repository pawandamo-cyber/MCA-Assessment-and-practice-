      "cell_type": "code",
      "source": [
        "# Install and import NLTK\n",
        "!pip install -q nltk\n",
        "\n",
        "import nltk\n",
        "\n",
        "# Download required NLTK resources\n",
        "nltk.download('punkt_tab')\n",
        "nltk.download('averaged_perceptron_tagger_eng')\n",
        "\n",
        "# Given sentences\n",
        "sentences = [\n",
        "    \"I enjoy reading books on machine learning.\",\n",
        "    \"The weather is sunny today.\"\n",
        "]\n",
        "\n",
        "# POS tagging\n",
        "for i, sentence in enumerate(sentences, 1):\n",
        "    print(\"=\" * 60)\n",
        "    print(f\"Sentence {i}: {sentence}\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    words = nltk.word_tokenize(sentence)\n",
        "    pos_tags = nltk.pos_tag(words)\n",
        "\n",
        "    print(\"\\nPOS Tags:\")\n",
        "    for word, tag in pos_tags:\n",
        "        print(f\"{word:15} -> {tag}\")\n",
        "\n",
        "print(\"\\nTag Significance:\")\n",
        "print(\"NN   = Noun\")\n",
        "print(\"NNS  = Plural noun\")\n",
        "print(\"VB   = Base form of verb\")\n",
        "print(\"VBP  = Verb, present tense\")\n",
        "print(\"VBG  = Verb/Gerund\")\n",
        "print(\"JJ   = Adjective\")\n",
        "print(\"RB   = Adverb\")\n",
        "print(\"DT   = Determiner\")\n",
        "print(\"IN   = Preposition\")\n",
        "print(\"PRP  = Personal pronoun\")\n",
        "print(\"CC   = Conjunction\")\n",
        "print(\"TO   = 'to'\")"
      ],
