      "source": [
        "# Install spaCy\n",
        "!pip install -q spacy\n",
        "\n",
        "# Download English model\n",
        "!python -m spacy download en_core_web_sm\n",
        "\n",
        "import spacy\n",
        "\n",
        "# Load English model\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "# Given sentence\n",
        "sentence = \"Apple Inc. was founded by Steve Jobs in Cupertino, California.\"\n",
        "\n",
        "# Process sentence\n",
        "doc = nlp(sentence)\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"SENTENCE\")\n",
        "print(\"=\" * 70)\n",
        "print(sentence)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. POS TAGGING\n",
        "# --------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"POS TAGGING\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "for token in doc:\n",
        "    print(f\"{token.text:15} -> POS: {token.pos_:8} | Tag: {token.tag_}\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. NAMED ENTITY EXTRACTION\n",
        "# --------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"NAMED ENTITIES\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "for ent in doc.ents:\n",
        "    print(f\"{ent.text:20} -> {ent.label_}\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. EXTRACT NOUNS\n",
        "# --------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"NOUNS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "for token in doc:\n",
        "    if token.pos_ in [\"NOUN\", \"PROPN\"]:\n",
        "        print(f\"{token.text:15} -> {token.pos_}\")\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. EXPLANATION\n",
        "# --------------------------------------------------\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"EXPLANATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"\"\"\n",
        "Named Entity Recognition identifies important real-world entities:\n",
        "\n",
        "Apple Inc.       -> ORG (Organization)\n",
        "Steve Jobs       -> PERSON\n",
        "Cupertino        -> GPE (Location)\n",
        "California       -> GPE (Location)\n",
        "\n",
        "Important POS tags:\n",
        "\n",
        "PROPN -> Proper Noun\n",
        "NOUN  -> Common Noun\n",
        "VERB  -> Verb\n",
        "ADP   -> Preposition\n",
        "DET   -> Determiner\n",
        "PUNCT -> Punctuation\n",
        "\n",
        "PROPN is especially important for named entity recognition because\n",
        "names of people, organizations and places are commonly represented\n",
        "as proper nouns.\n",
        "\"\"\")"
      ],
