    {
      "cell_type": "code",
      "source": [
        "# Install NLTK\n",
        "!pip install -q nltk\n",
        "\n",
        "import nltk\n",
        "from nltk.util import ngrams\n",
        "\n",
        "# Download tokenizer\n",
        "nltk.download('punkt_tab')\n",
        "\n",
        "# Given sentence\n",
        "sentence = \"I love natural language processing.\"\n",
        "\n",
        "# Tokenize the sentence\n",
        "words = nltk.word_tokenize(sentence)\n",
        "\n",
        "# Generate unigrams\n",
        "unigrams = list(ngrams(words, 1))\n",
        "\n",
        "print(\"Original Sentence:\")\n",
        "print(sentence)\n",
        "\n",
        "print(\"\\nTokens:\")\n",
        "print(words)\n",
        "\n",
        "print(\"\\nUnigrams:\")\n",
        "for unigram in unigrams:\n",
        "    print(unigram)\n",
        "\n",
        "print(\"\\nExplanation:\")\n",
        "print(\"A unigram is a single word/token considered independently.\")\n",
        "print(\"Unigrams are useful in language modeling because they help\")\n",
        "print(\"analyze the frequency and distribution of individual words.\")"
      ],
