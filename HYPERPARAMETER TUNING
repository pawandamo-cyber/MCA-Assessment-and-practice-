        "# ============================================\n",
        "# DECISION TREE - HYPERPARAMETER TUNING\n",
        "# ============================================\n",
        "\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.metrics import accuracy_score\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 1. Create customer behavioral dataset\n",
        "# ------------------------------------------------\n",
        "\n",
        "data = {\n",
        "    \"Age\": [20, 22, 25, 28, 30, 32, 35, 38, 40, 42,\n",
        "            45, 48, 50, 52, 55, 27, 33, 37, 44, 49],\n",
        "\n",
        "    \"Income\": [20000, 25000, 30000, 35000, 40000, 45000, 50000,\n",
        "               55000, 60000, 65000, 70000, 75000, 85000, 90000,\n",
        "               100000, 32000, 48000, 52000, 68000, 80000],\n",
        "\n",
        "    \"Previous_Purchase\": [\n",
        "        \"No\", \"No\", \"No\", \"Yes\", \"Yes\",\n",
        "        \"No\", \"Yes\", \"Yes\", \"Yes\", \"Yes\",\n",
        "        \"Yes\", \"Yes\", \"Yes\", \"Yes\", \"Yes\",\n",
        "        \"No\", \"Yes\", \"Yes\", \"Yes\", \"Yes\"\n",
        "    ],\n",
        "\n",
        "    \"Buying_Range\": [\n",
        "        \"Low\", \"Low\", \"Low\", \"Low\", \"Medium\",\n",
        "        \"Medium\", \"Medium\", \"Medium\", \"Medium\", \"High\",\n",
        "        \"High\", \"High\", \"High\", \"High\", \"High\",\n",
        "        \"Low\", \"Medium\", \"Medium\", \"High\", \"High\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"CUSTOMER BEHAVIORAL DATASET\")\n",
        "print(\"=\" * 50)\n",
        "print(df)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 2. Encode categorical data\n",
        "# ------------------------------------------------\n",
        "\n",
        "purchase_encoder = LabelEncoder()\n",
        "target_encoder = LabelEncoder()\n",
        "\n",
        "df[\"Previous_Purchase\"] = purchase_encoder.fit_transform(\n",
        "    df[\"Previous_Purchase\"]\n",
        ")\n",
        "\n",
        "df[\"Buying_Range\"] = target_encoder.fit_transform(\n",
        "    df[\"Buying_Range\"]\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 3. Separate features and target\n",
        "# ------------------------------------------------\n",
        "\n",
        "X = df[[\"Age\", \"Income\", \"Previous_Purchase\"]]\n",
        "y = df[\"Buying_Range\"]\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 4. Split data\n",
        "# ------------------------------------------------\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.30,\n",
        "    random_state=42,\n",
        "    stratify=y\n",
        ")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 5. Baseline Decision Tree\n",
        "# ------------------------------------------------\n",
        "\n",
        "baseline_model = DecisionTreeClassifier(\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "baseline_model.fit(X_train, y_train)\n",
        "\n",
        "baseline_pred = baseline_model.predict(X_test)\n",
        "\n",
        "baseline_accuracy = accuracy_score(\n",
        "    y_test,\n",
        "    baseline_pred\n",
        ")\n",
        "\n",
        "print(\"\\nBASELINE MODEL\")\n",
        "print(\"=\" * 50)\n",
        "print(\"Parameters: Default Decision Tree\")\n",
        "print(f\"Accuracy: {baseline_accuracy * 100:.2f}%\")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 6. Hyperparameter tuning\n",
        "# ------------------------------------------------\n",
        "\n",
        "results = []\n",
        "\n",
        "max_depth_values = [2, 3, 4, 5, None]\n",
        "min_samples_split_values = [2, 4, 6]\n",
        "\n",
        "for depth in max_depth_values:\n",
        "\n",
        "    for min_split in min_samples_split_values:\n",
        "\n",
        "        model = DecisionTreeClassifier(\n",
        "            max_depth=depth,\n",
        "            min_samples_split=min_split,\n",
        "            random_state=42\n",
        "        )\n",
        "\n",
        "        model.fit(X_train, y_train)\n",
        "\n",
        "        predictions = model.predict(X_test)\n",
        "\n",
        "        accuracy = accuracy_score(\n",
        "            y_test,\n",
        "            predictions\n",
        "        )\n",
        "\n",
        "        results.append({\n",
        "            \"max_depth\": depth,\n",
        "            \"min_samples_split\": min_split,\n",
        "            \"accuracy\": accuracy\n",
        "        })\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 7. Display tuning results\n",
        "# ------------------------------------------------\n",
        "\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "print(\"\\nHYPERPARAMETER TUNING RESULTS\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "results_display = results_df.copy()\n",
        "results_display[\"accuracy\"] = (\n",
        "    results_display[\"accuracy\"] * 100\n",
        ").round(2)\n",
        "\n",
        "print(results_display.to_string(index=False))\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 8. Find best parameters\n",
        "# ------------------------------------------------\n",
        "\n",
        "best_result = results_df.loc[\n",
        "    results_df[\"accuracy\"].idxmax()\n",
        "]\n",
        "\n",
        "best_depth = best_result[\"max_depth\"]\n",
        "best_min_split = int(best_result[\"min_samples_split\"])\n",
        "best_accuracy = best_result[\"accuracy\"]\n",
        "\n",
        "print(\"\\nBEST MODEL\")\n",
        "print(\"=\" * 50)\n",
        "print(f\"Best max_depth: {best_depth}\")\n",
        "print(f\"Best min_samples_split: {best_min_split}\")\n",
        "print(f\"Best Accuracy: {best_accuracy * 100:.2f}%\")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 9. Compare baseline and tuned model\n",
        "# ------------------------------------------------\n",
        "\n",
        "improvement = (\n",
        "    best_accuracy - baseline_accuracy\n",
        ") * 100\n",
        "\n",
        "print(\"\\nMODEL COMPARISON\")\n",
        "print(\"=\" * 50)\n",
        "print(f\"Baseline Accuracy : {baseline_accuracy * 100:.2f}%\")\n",
        "print(f\"Tuned Accuracy    : {best_accuracy * 100:.2f}%\")\n",
        "print(f\"Improvement       : {improvement:.2f}%\")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# 10. Explanation\n",
        "# ------------------------------------------------\n",
        "\n",
        "print(\"\\nEXPLANATION\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "print(\"\"\"\n",
        "Hyperparameter tuning improves the Decision Tree by testing\n",
        "different values of max_depth and min_samples_split.\n",
        "\n",
        "max_depth controls the maximum depth of the tree. A smaller\n",
        "depth makes the model simpler and can reduce overfitting.\n",
        "\n",
        "min_samples_split controls the minimum number of samples\n",
        "required to split an internal node.\n",
        "\n",
        "Different combinations are tested and their accuracy values\n",
        "are compared. The combination with the highest accuracy is\n",
        "selected as the tuned model.\n",
        "\n",
        "Therefore, hyperparameter tuning helps select a suitable tree\n",
        "structure and can improve the model's performance compared\n",
        "with the default Decision Tree.\n",
        "\"\"\")"
      ],
