      "source": [
        "# Install spaCy\n",
        "!pip install -q spacy\n",
        "\n",
        "# Download English language model\n",
        "!python -m spacy download en_core_web_sm\n",
        "\n",
        "import spacy\n",
        "\n",
        "# Load English model\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "# Given sentence\n",
        "sentence = \"Artificial intelligence is revolutionizing the tech industry.\"\n",
        "\n",
        "# Process the sentence\n",
        "doc = nlp(sentence)\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"Sentence:\", sentence)\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"\\nPOS Tags:\")\n",
        "for token in doc:\n",
        "    print(f\"{token.text:20} -> {token.pos_:6} -> {token.tag_}\")\n",
        "\n",
        "print(\"\\nTag Explanation:\")\n",
        "for token in doc:\n",
        "    print(f\"{token.text:20} : {token.pos_}\")"
      ],
